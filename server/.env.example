# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/glamconnect?schema=public"

# JWT Secret Key - Generate a strong random string for production
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=5000
NODE_ENV=development

# Email Service Configuration (for Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="GlamConnect <noreply@glamconnect.com>"

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Optional: Google OAuth (for future implementation)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Facebook OAuth (for future implementation)
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
