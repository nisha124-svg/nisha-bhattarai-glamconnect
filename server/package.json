{
    "name": "glamconnect-server",
    "version": "1.0.0",
    "description": "Backend for GlamConnect",
    "main": "dist/index.js",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "npx prisma generate && npx tsc",
        "postinstall": "npx prisma generate",
        "seed": "ts-node src/seed.ts"
    },
    "prisma": {
        "seed": "ts-node src/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^5.10.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.11.24",
        "@types/nodemailer": "^6.4.14",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.1.1",
        "nodemailer": "^6.9.11",
        "prisma": "^5.10.2",
        "socket.io": "^4.7.4",
        "stripe": "^14.19.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "twilio": "^4.23.0",
        "typescript": "^5.3.3"
    }
}
