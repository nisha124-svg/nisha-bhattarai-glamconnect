generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  role          Role     @default(USER)
  isApproved    Boolean  @default(true)
  loyaltyPoints Int      @default(0)
  totalSpent    Float    @default(0)
  membershipTier String  @default("BASIC") // BASIC, SILVER, GOLD, PLATINUM
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  appointments     Appointment[]
  reviews          Review[]
  notifications    Notification[]
  customerHistory  CustomerHistory[]
  ownedSalons      Salon[]
  loyaltyHistory   LoyaltyTransaction[]
}

model Salon {
  id          String   @id @default(uuid())
  name        String
  address     String
  image       String
  gallery     String[]
  description String
  tags        String[]
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  isVerified  Boolean  @default(false)
  autoAcceptBookings Boolean @default(true)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])
  latitude    Float?
  longitude   Float?
  city        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services        Service[]
  stylists        Stylist[]
  reviews         Review[]
  appointments    Appointment[]
  customerHistory CustomerHistory[]
  promoCodes      PromoCode[]
  chatMessages    ChatMessage[]
}

model Service {
  id        String   @id @default(uuid())
  name      String
  duration  Int      // in minutes
  price     Float
  category  String
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  
  appointments Appointment[]
}

model Stylist {
  id        String   @id @default(uuid())
  name      String
  role      String
  avatar    String
  rating    Float    @default(5.0)
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  
  appointments Appointment[]
  schedules    StaffSchedule[]
}

model Review {
  id            String   @id @default(uuid())
  rating        Int
  comment       String
  date          DateTime @default(now())
  isVerified    Boolean  @default(false) // true if user completed a booking at this salon
  appointmentId String?  // links review to a completed appointment
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id])
}

model Appointment {
  id        String   @id @default(uuid())
  date      DateTime
  status    AppointmentStatus @default(CONFIRMED)
  price     Float
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id])
  
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  
  stylistId String
  stylist   Stylist  @relation(fields: [stylistId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  message   String
  type      NotificationType @default(GENERAL)
  read      Boolean          @default(false)
  link      String?          // optional deep-link context (e.g. appointmentId)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())
}

// Real-time Chat Messages
model ChatMessage {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  senderName String
  senderRole String   // USER or SALON_OWNER
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id])
  createdAt  DateTime @default(now())
}

// Customer History - tracks customer preferences and notes
model CustomerHistory {
  id           String   @id @default(uuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  preferences  String?  // Customer preferences notes
  allergies    String?  // Any allergies or sensitivities
  notes        String?  // General notes about the customer
  totalVisits  Int      @default(0)
  totalSpent   Float    @default(0)
  lastVisit    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([salonId, userId])
}

// Promotional Codes / Discount Codes
model PromoCode {
  id            String   @id @default(uuid())
  code          String   @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float    // Percentage (0-100) or fixed amount
  minPurchase   Float?   // Minimum purchase amount to apply
  maxUses       Int?     // Maximum number of uses (null = unlimited)
  usedCount     Int      @default(0)
  validFrom     DateTime @default(now())
  validUntil    DateTime?
  isActive      Boolean  @default(true)
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Staff Schedule for daily schedule view
model StaffSchedule {
  id         String   @id @default(uuid())
  stylistId  String
  stylist    Stylist  @relation(fields: [stylistId], references: [id])
  dayOfWeek  Int      // 0 = Sunday, 1 = Monday, etc.
  startTime  String   // HH:MM format
  endTime    String   // HH:MM format
  isWorking  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([stylistId, dayOfWeek])
}

// Loyalty Points Transaction History
model LoyaltyTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  points      Int      // Positive for earned, negative for redeemed
  type        LoyaltyType
  description String?
  appointmentId String?
  createdAt   DateTime @default(now())
}

enum LoyaltyType {
  EARNED
  REDEEMED
  BONUS
  EXPIRED
  REFERRAL
}

enum Role {
  USER
  ADMIN
  SALON_OWNER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  GENERAL
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REJECTED
  BOOKING_RESCHEDULED
  BOOKING_COMPLETED
  BOOKING_REQUEST
  NEW_REVIEW
  CHAT_MESSAGE
}
